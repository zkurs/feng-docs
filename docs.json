{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Feng",
  "description": "Setup and reference guides for the Feng Discord bot.",
  "colors": {
    "primary": "#b85f67",
    "light": "#d89aa0",
    "dark": "#8f353d"
  },
  "favicon": "/feng-avatar.png",
  "appearance": {"default": "dark", "strict": true},
  "navigation": {
    "groups": [
      {"group": "Overview", "pages": ["overview/introduction", "overview/setup"]},
      {"group": "Security", "pages": ["security/antinuke", "security/antiraid"]},
      {"group": "Moderation", "pages": ["moderation/overview", "moderation/filters"]},
      {
        "group": "Server configuration",
        "pages": [
          "configuration/logging",
          "configuration/tickets",
          "configuration/voicemaster",
          "configuration/autoresponders"
        ]
      },
      {"group": "Integrations", "pages": ["integrations/spotify", "integrations/lastfm"]},
      {"group": "Resources", "pages": ["resources/syntax"]},
      {"group": "Troubleshooting", "pages": ["troubleshooting/common-issues"]}
    ]
  },
  "logo": {"light": "/feng-avatar.png", "dark": "/feng-avatar.png"},
  "navbar": {
    "links": [
      {"label": "Commands", "href": "https://feng.up.railway.app/commands"},
      {"label": "Status", "href": "https://feng.up.railway.app/status"}
    ],
    "primary": {"type": "button", "label": "Feng home", "href": "https://feng.up.railway.app/"}
  },
  "seo": {
    "metatags": {"theme-color": "#0a0708", "og:site_name": "Feng documentation"},
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zkurs/feng-docs",
      "discord": "https://discord.gg/grQSQpRy6"
    }
  },
  "redirects": [
    {"source": "/", "destination": "/overview/introduction"},
    {"source": "/index", "destination": "/overview/introduction"},
    {"source": "/quickstart", "destination": "/overview/setup"},
    {"source": "/commands", "destination": "https://feng.up.railway.app/commands"},
    {"source": "/status", "destination": "https://feng.up.railway.app/status"}
  ]
}
